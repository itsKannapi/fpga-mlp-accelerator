# ============================================================================
# create_project.tcl -- rebuild the Vivado project from the sources in git
#
# The Vivado project (vivado/) is NOT committed: it is thousands of generated
# files and contains absolute paths from whoever created it. Instead, every
# team member runs this once after cloning, and again any time the project
# gets into a weird state. It is safe to re-run; it rebuilds from scratch.
#
# How to run (pick one):
#   GUI   : Vivado start screen -> Tcl Console at the bottom ->
#             source C:/path/to/repo/scripts/create_project.tcl
#           (close any open project first: File -> Close Project)
#   Shell : vivado -mode batch -source scripts/create_project.tcl
#
# What it does:
#   1. writes vivado/data_dir.vh, which tells the Verilog where rtl/ lives on
#      THIS machine (so nobody's paths are hard-coded in committed files)
#   2. creates vivado/mlp_accel/mlp_accel.xpr for the Basys 3 part
#   3. adds every src/*.v as a design source, every sim/*.v as a sim source,
#      WITHOUT copying them (the files in git stay the only copy)
#   4. sets include paths, the simulation top, and run-to-completion
# ============================================================================

set repo      [file normalize [file join [file dirname [info script]] ..]]
set proj_dir  [file join $repo vivado]
set proj_name mlp_accel
set part      xc7a35tcpg236-1

set sim_top   tb_layer1      ;# change to run a different testbench
set synth_top layer1         ;# becomes the board-level top module later

puts "repo root: $repo"
file mkdir $proj_dir

# ---- 1. machine-specific path header -------------------------------------
set fh [open [file join $proj_dir data_dir.vh] w]
puts $fh "// Generated by scripts/create_project.tcl -- machine-specific, not committed."
puts $fh "`ifndef DATA_DIR"
puts $fh "`define DATA_DIR \"$repo/rtl/\""
puts $fh "`endif"
close $fh

# ---- 2. project ---------------------------------------------------------------
create_project $proj_name [file join $proj_dir $proj_name] -part $part -force
set_property target_language Verilog [current_project]

# ---- 3. sources (referenced in place, never copied) --------------------------
add_files -norecurse [glob [file join $repo src *.v]]
add_files -fileset sim_1 -norecurse [glob [file join $repo sim *.v]]

# ---- 4. settings -----------------------------------------------------------------
set inc [list [file join $repo rtl] $proj_dir]
set_property include_dirs $inc [get_filesets sources_1]
set_property include_dirs $inc [get_filesets sim_1]

set_property top $synth_top [get_filesets sources_1]
set_property top $sim_top   [get_filesets sim_1]
set_property -name {xsim.simulate.runtime} -value {-all} -objects [get_filesets sim_1]

update_compile_order -fileset sources_1
update_compile_order -fileset sim_1

puts ""
puts "Project ready: [file join $proj_dir $proj_name $proj_name.xpr]"
puts "Simulation top: $sim_top   (Flow Navigator -> Run Simulation)"
